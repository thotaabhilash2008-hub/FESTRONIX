{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/functions/[name].ts": {
      "regions": ["bom1"],
      "maxDuration": 60
    },
    "api/qr/[token].ts": {
      "regions": ["bom1"],
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        { "type": "host", "value": "^festronix\\.com$" }
      ],
      "destination": "https://www.festronix.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
